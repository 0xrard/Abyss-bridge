# --- Abyss Bridge frontend env (copy to .env.local) ---

# Solana L1 RPC (devnet by default)
NEXT_PUBLIC_L1_RPC=https://api.devnet.solana.com
# MagicBlock Ephemeral Rollup endpoint — the ASIA validator
# (devnet-as) hosts all game accounts; the generic endpoint only
# serves a stale mirror of them.
NEXT_PUBLIC_ER_RPC=https://devnet-as.magicblock.app
# Deployed program id (live on devnet)
NEXT_PUBLIC_PROGRAM_ID=Gw5k91LH43GRxwS335Bnw8o3BNWF16Lkm57LwHypF9XX
# Mock USDC mint on devnet (created during setup). Deposit/withdraw
# and the faucet stay disabled until this is set.
NEXT_PUBLIC_MOCK_USDC_MINT=4GP8vbT9hrHfMmoJnfXeErFAAEL54UPfSRqZXC4Q79pi
# Ephemeral validator every account delegates to: MAS1… is the
# Asia devnet validator (the delegation program's default target).
NEXT_PUBLIC_ER_VALIDATOR=MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57

# --- Server-only (faucet API route) ---
# Mint-authority keypair secret key, base64-encoded (devnet only!)
FAUCET_KEYPAIR_SECRET=
MOCK_USDC_MINT=4GP8vbT9hrHfMmoJnfXeErFAAEL54UPfSRqZXC4Q79pi
L1_RPC_URL=https://api.devnet.solana.com
